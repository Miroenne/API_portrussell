<!-- Button trigger modal -->
<button type="button" class="btn btn-success mt-5" data-bs-toggle="modal" data-bs-target="#addingModal">
    <%= title %>
</button>

<!-- Adding Modal -->
<div class="modal fade" id="addingModal" tabindex="-1" aria-labelledby="addingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="addingModalLabel"><%= title %></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="<%= action %>" method="<%= method %>" enctype="application/x-www-form-urlencoded">
                    <div class="mb-3">
                        <label for="<%= id1 %>" class="form-label"><%= label1 %></label>
                        <input type="<%= type1 %>" class="form-control" id="<%= id1 %>" name="<%= id1 %>">
                    </div>
                    <div class="mb-3">
                        <label for="<%= id2 %>" class="form-label"><%= label2 %></label>
                        <input type="<%= type2 %>" class="form-control" id="<%= id2 %>" name="<%= id2 %>">
                    </div>
                    <div class="mb-3">
                        <label for="<%= id3 %>" class="form-label"><%= label3 %></label>
                        <input type="<%= type3 %>" class="form-control" id="<%= id3 %>" name="<%= id3 %>">
                    </div>
                    <div class="mb-3">
                        <label for="<%= id4 %>" class="form-label <%= display %>"><%= label4 %></label>
                        <input type="<%= type4 %>" class="form-control <%= display %>" id="<%= id4 %>" name="<%= id4 %>">
                    </div>
                    <div class="mb-3">
                        <label for="<%= id5 %>" class="form-label <%= display %>"><%= label5 %></label>
                        <input type="<%= type5 %>" class="form-control <%= display %>" id="<%= id5 %>" name="<%= id5 %>">
                    </div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <input type="submit" class="btn btn-primary" value="Valider">                    
                </form>
            </div>               
        </div>            
    </div>
</div>

<!-- Confirm Modal -->

<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="confirmModalLabel">Confirmation d'ajout</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><%= confirmMessage %></p>
            </div>               
        </div>            
    </div>
</div>