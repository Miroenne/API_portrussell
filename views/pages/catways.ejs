<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>Port Russell - Catways</title>
</head>
<body>
    <header>
        <%- include('../partials/menu') %>
    </header>
    
    <main>
        <%- include('../partials/addUpdateModal', {
            modalId: 'addmodal',
            textPosition : undefined,
            deleteAction : undefined,
            overrideDeleteMethod : undefined,
            secondFormDisplay : "d-none",
            action : "http://localhost:3000/catways",
            method : "POST",            
            overrideUpdateMethod : undefined,
            value1: undefined,
            value2: undefined,
            value3: undefined,
            value4 : undefined,
            value5: undefined,
            title : "Ajouter un catway",
            label1: "Numéro de catway",
            type1: "text",
            id1 : "catwayNumber",
            write1 : undefined,
            label2: "Type de catway",
            type2: "text",
            id2: "catwayType",
            write2 : undefined,
            label3: "État du catway",
            type3: "text",
            id3: "catwayState",
            write3 : undefined,
            label4 : undefined,
            type4: undefined,
            id4 : undefined,
            write4 : undefined,
            label5: undefined,
            type5: undefined,
            id5: undefined,
            write5 : undefined,
            inputDisplay : "d-none",
            margin: "mt-5",
            confirmMessage : "Le catway a bien été ajouté."
        }) %>
        <div class="container-fluid mt-5">
            <div class="row justify-content-evenly">
            <% if (catways && catways.length > 0) { %>
                <% catways.forEach(catway => { %>
                    <%- include('../partials/catwayCard',{
                        catwayNumber : catway.catwayNumber,
                        catwayType :  catway.catwayType,
                        catwayState : catway.catwayState
                    }) %>
                <% }) %>
            <% } else { %>
                <p>Aucun catway trouvé.</p>
            <% } %>
            </div>            
        </div>        
    </main>
    <% if (showConfirmModal) { %>
        <script>
            const confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));
            confirmModal.show();        
        </script>
    <% } %>    
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>